# ===== إلزامي: قاعدة البيانات Turso (libsql عبر HTTP — متوافقة مع Vercel) =====
# أنشئ قاعدة مجانية من app.turso.io ثم انسخ القيم
TURSO_DATABASE_URL=libsql://<your-db>-<your-user>.turso.io
TURSO_AUTH_TOKEN=<your-auth-token>

# ===== اختياري: عنوان خدمة دمج الفيديو (Video Merger API v2) =====
# بلا مفاتيح أو توثيق — المخرج MP4 (H.264+AAC) حتى 1080p
# بدون هذه القيمة تعمل كل الأدوات ما عدا merge_videos
MERGER_API_BASE=https://your-merger-service.example.com

# ===== اختياري: حماية مسار /mcp بتوكن =====
# عند ضبطه يُطلب على العملاء: Authorization: Bearer <القيمة>
# MCP_ACCESS_TOKEN=

# ===== اختياري: تجاوز أسماء الموديلات لدى المزودين =====
# KIE_IMAGE_MODEL=gpt-image-2-6/flare-text-to-image
# KIE_VIDEO_MODEL=grok-imagine-video-1-5-preview
# COMETAPI_IMAGE_MODEL=gpt-image-2.6-flare-text-to-image
# COMETAPI_VIDEO_MODEL=grok-imagine-video-1-5-preview

# ===== اختياري: تجاوز عناوين المزودين =====
# KIE_API_BASE=https://api.kie.ai
# COMETAPI_API_BASE=https://api.cometapi.com

# ===== لتهيئة أول مفتاح تلقائيًا (سكربت seed فقط — ليس للسيرفر) =====
# KIE_SEED_KEY=
# KIE_SEED_LABEL=kie الرئيسي
